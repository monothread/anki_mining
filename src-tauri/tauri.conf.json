{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AnkiMining",
    "version": "0.1.0",
    "identifier": "dev.ankimining.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../web-dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "AnkiMining",
                "width": 900,
                "height": 620,
                "transparent": true,
                "decorations": false,
                "alwaysOnTop": true,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "appimage"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNkY1QjdCNEREMjY5MDgKUldRSWFkSk5lMXR2TXhMRWdpakd3OENTQmVDbjNSUGdobWt0by9QeEdxdStVY3JtL3V2WlJiOUoK",
            "endpoints": [
                "https://github.com/monothread/anki_mining/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
