# Builds and tests the Windows version of anki_mining on Linux, so nothing but Docker is needed:
#  - the app is cross-compiled for x86_64-pc-windows-msvc with cargo-xwin (clang, lld and the
#    Microsoft CRT/SDK files that xwin downloads on first use into the /cache bind mount)
#  - Tauri builds the NSIS installer on Linux with `nsis`
#  - the tests and the app self-test run under Wine on a virtual display (xvfb)
#  - the speech helper (a small C program) is built with mingw-w64
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_HOME=/cache/cargo \
    XWIN_CACHE_DIR=/cache/xwin \
    CARGO_TARGET_DIR=/cache/target-win \
    WINEPREFIX=/cache/wine \
    WINEDEBUG=-all

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        curl \
        file \
        git \
        gzip \
        libssl-dev \
        lld \
        llvm \
        mingw-w64 \
        nsis \
        p7zip-full \
        pkg-config \
        python3 \
        unzip \
        wget \
        wine64 \
        xauth \
        xvfb \
        zip \
    && ln -sf "$(ls /usr/bin/llvm-rc-* | head -1)" /usr/local/bin/llvm-rc \
    && ln -sf /usr/lib/wine/wine64 /usr/local/bin/wine64 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | CARGO_HOME=/usr/local/cargo sh -s -- -y --profile minimal --default-toolchain stable \
           --target x86_64-pc-windows-msvc \
    && CARGO_HOME=/usr/local/cargo cargo install --locked cargo-xwin \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

# Wine 11 from WineHQ: the Wine of Ubuntu 22.04 (6.0) lacks DLLs that current Rust programs need
# (bcryptprimitives.dll), so it cannot run the tests or the app.
RUN dpkg --add-architecture i386 \
    && mkdir -pm755 /etc/apt/keyrings \
    && wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
    && wget -qNP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends wine-stable-amd64 wine-stable-i386 wine-stable \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/wine-stable/bin:$PATH

WORKDIR /workspace
