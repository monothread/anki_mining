node_modules/
dist/
web-dist/
.cache/
src-tauri/target/
src-tauri/gen/
*.AppImage
.env

# OCR models and the ONNX Runtime library are downloaded by scripts/fetch-ocr-models.sh
src-tauri/resources/ocr/*.onnx
src-tauri/resources/ocr/*.so

# The bundled dictionary is built by scripts/build-dictionary.sh
src-tauri/resources/dictionary/*.db

# The speech files are fetched by scripts/fetch-tts.sh (they carry the VOICEVOX terms of use)
src-tauri/resources/tts/*
!src-tauri/resources/tts/README.md
